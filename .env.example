# Copy to .env and fill in your secret. Never commit .env (it is git-ignored).
# Your Meta Model API key. Get it from your Meta developer account.
MODEL_API_KEY=

# Optional overrides (defaults shown).
# MODEL_API_BASE=https://api.meta.ai/v1
# FLOWFORGE_SAM_ENDPOINT=https://api.meta.ai/v1/sam/segment
# Solver image (must contain libcorrectedKOmegaSST; see docker/openfoam.Dockerfile).
# FLOWFORGE_OPENFOAM_IMAGE=flowforge-openfoam:local

# Set to 1 for zero-token replay mode (no network calls, useful for UI work).
# FLOWFORGE_REPLAY=1
