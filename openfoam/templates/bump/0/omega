FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 200.0;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 200.0;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            omegaWallFunction;
        value           uniform 200.0;
    }
    topWall
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}
