}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.0375;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.0375;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            kqRWallFunction;
        value           uniform 0.0375;
    }
    symmetry
    {
        type            symmetry;
    }
    freestream
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
